<!-- Section -->
    <section id="kontak">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
      <div class="card shadow-sm border-0 p-4">
        <h3 class="fw-bold text-center mb-4">Hubungi Saya</h3>
        <form id="formKontak" onsubmit="event.preventDefault(); var myModal = new bootstrap.Modal(document.getElementById('modalSukses')); myModal.show();">
          <div class="mb-3">
            <label for="inputNama" class="form-label fw-semibold">Nama Lengkap</label>
            <input type="text" class="form-control" id="inputNama" placeholder="Masukkan nama Anda" required>
          </div>
          <div class="mb-3">
            <label for="inputEmail" class="form-label fw-semibold">Alamat Email</label>
            <input type="email" class="form-control" id="inputEmail" placeholder="nama@email.com" required>
          </div>
          <div class="mb-4">
            <label for="inputPesan" class="form-label fw-semibold">Pesan</label>
            <textarea class="form-control" id="inputPesan" rows="4" placeholder="Tulis pesan Anda di sini..." required></textarea>
          </div>
          <button type="submit" class="btn btn-warning w-100 fw-bold text-dark">Kirim Pesan</button>
        </form>
      </div>
    </div>
  </div>

        <div class="modal fade" id="modalSukses" tabindex="-1" aria-labelledby="modalSuksesLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold text-success" id="modalSuksesLabel">Pesan Terkirim!</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center py-4">
        <p class="fs-5 text-dark">Terima kasih! Pesan Anda telah berhasil dikirim dan di konfirmasi.</p>
      </div>
      <div class="modal-footer border-0 justify-content-center">
        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Tutup</button>
      </div>
    </div>
  </div>
